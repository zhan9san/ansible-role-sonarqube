name: sonarqube

services:
  sonarqube:
    image: {{ sonarqube_image }}
    container_name: sonarqube
    restart: unless-stopped
    read_only: true
    depends_on:
      db:
        condition: service_healthy
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://db:5432/{{ sonarqube_db_name }}
      SONAR_JDBC_USERNAME: {{ sonarqube_db_user }}
      SONAR_JDBC_PASSWORD: ${POSTGRES_PASSWORD}
      SONAR_CORE_SERVERBASEURL: {{ sonarqube_url | to_json }}
{% if sonarqube_ldap_enabled %}
      SONAR_SECURITY_REALM: LDAP
      SONAR_AUTHENTICATOR_IGNORESTARTUPFAILURE: "{{ sonarqube_ldap_ignore_startup_failure | bool | lower }}"
      LDAP_URL: {{ sonarqube_ldap_url | to_json }}
      LDAP_BINDDN: {{ sonarqube_ldap_bind_dn | to_json }}
      LDAP_BINDPASSWORD: ${LDAP_BIND_PASSWORD}
      LDAP_USER_BASEDN: {{ sonarqube_ldap_user_base_dn | to_json }}
      LDAP_USER_REQUEST: {{ sonarqube_ldap_user_request | to_json }}
      LDAP_USER_REALNAMEATTRIBUTE: {{ sonarqube_ldap_user_real_name_attribute | to_json }}
      LDAP_USER_EMAILATTRIBUTE: {{ sonarqube_ldap_user_email_attribute | to_json }}
{% if sonarqube_ldap_group_base_dn %}
      LDAP_GROUP_BASEDN: {{ sonarqube_ldap_group_base_dn | to_json }}
      LDAP_GROUP_REQUEST: {{ sonarqube_ldap_group_request | to_json }}
      LDAP_GROUP_IDATTRIBUTE: {{ sonarqube_ldap_group_id_attribute | to_json }}
{% endif %}
{% endif %}
{% for key, value in sonarqube_env.items() %}
      {{ key }}: {{ (value | lower if value is boolean else value) | string | to_json }}
{% endfor %}
    ulimits:
      nofile:
        soft: 131072
        hard: 131072
      nproc: 8192
    volumes:
      - data:/opt/sonarqube/data
      - extensions:/opt/sonarqube/extensions
      - logs:/opt/sonarqube/logs
      - temp:/opt/sonarqube/temp
    tmpfs:
      - /tmp:size=256M,mode=1777
    ports:
      - "{{ sonarqube_listen_address }}:{{ sonarqube_port }}:9000"

  db:
    image: {{ sonarqube_db_image }}
    container_name: sonarqube-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ sonarqube_db_name }}
      POSTGRES_USER: {{ sonarqube_db_user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d {{ sonarqube_db_name }} -U {{ sonarqube_db_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - db:{{ sonarqube_db_data_dir }}

volumes:
  data:
  extensions:
  logs:
  temp:
  db:
